# ==============================================================================
# Jaanch ML Inference Service - Environment Variables Template
# Copy this file to .env and configure for your environment.
# ==============================================================================

# Application Environment: 'development' or 'production'
# In 'production', API_KEY authentication is strictly enforced.
ENVIRONMENT=development

# Shared API Key required in headers (X-API-Key or Bearer token)
# Required in production; optional in development when left empty.
API_KEY=

# Model Artifact Configuration
MODEL_PATH=models/jaanch_scam_model_v3_calibrated.joblib
MODEL_VERSION=tfidf-logreg-v3-calibrated

# Decision Policy Thresholds
LOW_THRESHOLD=0.50
MEDIUM_THRESHOLD=0.75

# Safety Guardrail: Max allowed severity level (hard-capped at 'medium')
MAX_SEVERITY=medium

# Allowed CORS Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-jaanch-domain.com

# Server Port and Request Timeout
PORT=8000
REQUEST_TIMEOUT_SECONDS=5.0

